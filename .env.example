# Optional path overrides. Relative values are resolved from the process cwd.
WCG_DATA_ROOT=.data
# WCG_RUNTIME_ROOT=
# WCG_DELIVERABLES_ROOT=
# WCG_BACKUPS_ROOT=
# WCG_WECHAT_CONFIG_FILE=

# OpenAI-compatible provider. The application intentionally accepts loopback URLs only.
CPA_BASE_URL=http://127.0.0.1:8317/v1
CPA_API_KEY=replace_with_local_provider_key
CPA_MODEL=gpt-5.4-mini

# WeChat Official Account configuration. Keep draft_only until the complete flow is verified.
WECHAT_APP_ID=wx_your_app_id
WECHAT_APP_SECRET=replace_with_app_secret
WECHAT_TOKEN=replace_with_callback_token
WECHAT_ENCODING_AES_KEY=
WECHAT_CALLBACK_URL=https://your-domain.example/api/wechat/callback
WECHAT_PUBLISH_MODE=draft_only
